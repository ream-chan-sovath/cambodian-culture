---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { enabledLocales, type Locale } from '../site.config';
import { htmlLang, localeUrl, useTranslations } from '../i18n/utils';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import Analytics from '../components/site/Analytics.astro';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Path after the locale prefix, used for the language switcher and alternates. */
  path?: string;
  available?: readonly Locale[];
  /** Absolute or site-relative image for social previews. */
  ogImage?: string;
  headerTone?: 'plum' | 'cotton';
  current?: 'home' | 'about';
}

const { locale, title, description, path = '', available = enabledLocales, ogImage, headerTone = 'cotton', current } = Astro.props;
const t = useTranslations(locale);
const fullTitle = title ? `${title} | ${t('siteName')}` : t('siteName');
const pageDescription = description ?? t('tagline');
const canonical = new URL(localeUrl(locale, path), Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <meta name="theme-color" content="#3b1631" />
    {available.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(localeUrl(l, path), Astro.site)} />)}
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title ?? t('siteName')} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t('siteName')} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

    <Font cssVariable="--font-bodoni" preload />
    <Font cssVariable="--font-literata" preload />
    <Font cssVariable="--font-moul" />
    <Font cssVariable="--font-noto-khmer" />
    {locale === 'zh' && <Font cssVariable="--font-noto-sc" />}

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    <Header locale={locale} path={path} available={available} tone={headerTone} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
