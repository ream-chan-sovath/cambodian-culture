---
import { useTranslations } from '../../i18n/utils';

// A gold thread down the left edge on wide screens: fills as you read, with a mark for each chapter.
const locale = Astro.locals.locale ?? 'en';
const t = useTranslations(locale);
---

<div class="thread" aria-hidden="true" data-thread title={t('readingProgress')}>
  <div class="thread__fill"></div>
</div>

<style>
  .thread {
    display: none;
  }
  @media (min-width: 1200px) {
    .thread {
      display: block;
      position: fixed;
      left: 1.25rem;
      top: 15vh;
      bottom: 15vh;
      width: 1px;
      background: var(--rule-gold);
      z-index: 10;
      opacity: 0;
      transition: opacity 0.3s;
    }
    .thread.is-shown {
      opacity: 1;
    }
  }
  .thread__fill {
    position: absolute;
    inset: 0 0 auto;
    height: calc(var(--progress, 0) * 100%);
    background: var(--gold-deep);
  }
  .thread :global(.thread__mark) {
    position: absolute;
    left: -3px;
    width: 7px;
    height: 7px;
    rotate: 45deg;
    background: var(--cotton);
    border: 1px solid var(--gold-deep);
  }
  .thread :global(.thread__mark.is-passed) {
    background: var(--gold-deep);
  }
</style>

<script>
  const thread = document.querySelector<HTMLElement>('[data-thread]');
  const article = document.querySelector<HTMLElement>('[data-article]');
  if (thread && article) {
    const gates = [...document.querySelectorAll<HTMLElement>('[data-gate]')];
    const marks = gates.map(() => {
      const mark = document.createElement('span');
      mark.className = 'thread__mark';
      thread.append(mark);
      return mark;
    });

    let ticking = false;
    const update = () => {
      ticking = false;
      const start = article.offsetTop;
      const length = Math.max(1, article.offsetHeight - window.innerHeight);
      const progress = Math.min(1, Math.max(0, (window.scrollY - start) / length));
      thread.style.setProperty('--progress', String(progress));
      // Stay out of the way until the reader is past the hero.
      const hero = article.querySelector<HTMLElement>('.hero');
      thread.classList.toggle('is-shown', window.scrollY > (hero ? hero.offsetTop + hero.offsetHeight - window.innerHeight * 0.5 : 0));
      gates.forEach((gate, i) => {
        const at = Math.min(1, Math.max(0, (gate.offsetTop - start) / length));
        marks[i].style.top = `calc(${at * 100}% - 3px)`;
        marks[i].classList.toggle('is-passed', progress >= at);
      });
    };
    const request = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);
    update();
  }
</script>
