---
// A band of kbach phni tes (flame) ornament: a flame bud between two outward scrolls,
// repeated along a baseline. Stroked so chapter gates can draw it in.
interface Props {
  class?: string;
  flip?: boolean;
  units?: number;
}

const { class: className, flip = false, units = 24 } = Astro.props;
const unit = 80;
const width = units * unit;
const offsets = Array.from({ length: units }, (_, i) => i * unit);
---

<svg
  class:list={['kbach-border', className, { 'kbach-border--flip': flip }]}
  viewBox={`0 0 ${width} 44`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <g fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
    <path class="kbach-line" pathLength="1" d={`M0 41.5 H${width}`}></path>
    {
      offsets.map((x) => (
        <g transform={`translate(${x} 0)`}>
          <path class="kbach-line" pathLength="1" d="M40 38 C31 32 31 21 38 13 C40 10.5 40.5 8 39.5 4.5 C47 10.5 50 21 45.5 29 C44 32 42 35 40 38 Z" />
          <path class="kbach-line" pathLength="1" d="M40 35 C37.5 29 38 22 41.5 16" />
          <path class="kbach-line" pathLength="1" d="M40 38 C30 38 20 35 15 28 C11.5 23 14 17 19 17.5 C23.5 18 24 23.5 20.5 24.5 C18.5 25 17 23.5 18 22" />
          <path class="kbach-line" pathLength="1" d="M40 38 C50 38 60 35 65 28 C68.5 23 66 17 61 17.5 C56.5 18 56 23.5 59.5 24.5 C61.5 25 63 23.5 62 22" />
          <path class="kbach-line" pathLength="1" d="M80 38 C76.5 35 76.5 30 80 26.5 C83.5 30 83.5 35 80 38 Z" />
        </g>
      ))
    }
  </g>
</svg>

<style>
  .kbach-border {
    display: block;
    width: 100%;
    height: 44px;
    color: var(--palace-gold);
  }
  .kbach-border--flip {
    transform: scaleY(-1);
  }
</style>
