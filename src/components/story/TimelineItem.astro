---
import { localNumber } from '../../i18n/utils';

interface Props {
  year: string;
  title: string;
}

const { year, title } = Astro.props;
const locale = Astro.locals.locale ?? 'en';
---

<li class="moment">
  <p class="moment__year">{localNumber(year, locale)}</p>
  <div class="moment__body">
    <h3 class="moment__title">{title}</h3>
    <slot />
  </div>
</li>

<style>
  .moment {
    position: relative;
    display: grid;
    gap: 0.1rem 2rem;
    padding: 0 0 2.25rem 2rem;
  }
  .moment::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 0.75rem;
    height: 0.75rem;
    rotate: 45deg;
    background: var(--cotton);
    border: 1px solid var(--palace-gold);
  }
  @media (min-width: 1100px) {
    .moment {
      grid-template-columns: 7.5rem minmax(0, var(--measure));
      padding-left: 0;
    }
    .moment::before {
      left: 9rem;
    }
    .moment__year {
      text-align: right;
      padding-right: 1rem;
    }
    .moment__body {
      padding-left: 1.5rem;
    }
  }
  .moment__year {
    margin: 0;
    font-family: var(--display);
    font-size: var(--step-24);
    line-height: 1.3;
    color: var(--gold-deep);
    font-variant-numeric: lining-nums;
  }
  .moment__title {
    font-size: var(--step-24);
    margin-bottom: 0.35rem;
  }
  .moment__title:lang(km),
  :global(:lang(km)) .moment__title {
    font-family: var(--reading);
    font-weight: 700;
    font-size: var(--step-21);
    line-height: 1.7;
  }
  .moment__body :global(p) {
    margin: 0 0 0.6rem;
  }
</style>
