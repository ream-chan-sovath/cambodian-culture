---
import { enabledLocales, type Locale } from '../../site.config';
import { languageNames } from '../../i18n/ui';
import { htmlLang, localeUrl, useTranslations } from '../../i18n/utils';

interface Props {
  locale: Locale;
  /** Path after the locale, e.g. "apsara-royal-ballet/". */
  path: string;
  /** Languages this page exists in. Defaults to all. */
  available?: readonly Locale[];
  /** Match the header: plum glass on plum, cotton glass on cotton. */
  tone?: 'plum' | 'cotton';
}

const { locale, path, available = enabledLocales, tone = 'plum' } = Astro.props;
const t = useTranslations(locale);
const shown = enabledLocales.filter((l) => available.includes(l) || l === locale);
const light = tone === 'cotton';
---

<details class="lang" data-lang>
  <summary class:list={['lang__button', 'glass', { 'glass--light': light }]}>
    <span aria-hidden="true">🌐</span>
    {t('language')}
  </summary>
  <ul class:list={['lang__menu', 'glass', 'glass--panel', light ? 'glass--light' : 'glass--strong']}>
    {
      shown.map((l) => (
        <li>
          <a
            href={localeUrl(l, path)}
            hreflang={htmlLang[l]}
            lang={htmlLang[l]}
            aria-current={l === locale ? 'true' : undefined}
          >
            {languageNames[l]}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .lang {
    position: relative;
  }
  .lang__button {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.95rem;
    font-size: var(--step-16);
    line-height: 1.5;
    list-style: none;
    user-select: none;
  }
  .lang__button::-webkit-details-marker {
    display: none;
  }
  .lang[open] .lang__button {
    --k-tint: rgb(233 207 138 / 0.92);
    --k-tint-hover: rgb(233 207 138 / 1);
    --k-edge: 138 101 16;
    color: var(--silk-plum);
  }

  .lang__menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    z-index: 30;
    min-width: 10rem;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
  }
  .lang__menu a {
    display: block;
    padding: 0.4rem 0.7rem;
    border-radius: 0.3rem;
    color: inherit;
    text-decoration: none;
    font-size: var(--step-16);
    line-height: 1.6;
  }
  .lang__menu a:hover {
    background: rgb(255 255 255 / 0.1);
  }
  .lang__menu.glass--light a:hover {
    background: rgb(59 22 49 / 0.08);
  }
  .lang__menu a[aria-current] {
    color: var(--gold-pale);
    font-weight: 600;
  }
  .lang__menu.glass--light a[aria-current] {
    color: var(--gold-deep);
  }
</style>

<script>
  // Close the menu on outside click or Escape, and when another one opens.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('[data-lang]')];
  menus.forEach((el) => {
    el.addEventListener('toggle', () => {
      if (el.open) menus.forEach((other) => other !== el && (other.open = false));
    });
  });
  document.addEventListener('click', (event) => {
    menus.forEach((el) => {
      if (el.open && !el.contains(event.target as Node)) el.open = false;
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    menus.forEach((el) => {
      if (el.open) {
        el.open = false;
        el.querySelector('summary')?.focus();
      }
    });
  });
</script>
