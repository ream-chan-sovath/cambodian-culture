---
import { siteConfig } from '../../site.config';

// Counts page views on the live site only. No cookies, so no consent banner is needed.
const token = siteConfig.cloudflareAnalyticsToken.trim();
const enabled = import.meta.env.PROD && token.length > 0;
---

{enabled && <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token })}></script>}
