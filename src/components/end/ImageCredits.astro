---
import type { Credit } from '../../lib/media';
import type { Locale } from '../../site.config';
import { useTranslations } from '../../i18n/utils';

interface Props {
  credits: [string, Credit][];
  locale: Locale;
  headingLevel?: 'h2' | 'h3';
  title?: string;
}

const { credits, locale, headingLevel: Heading = 'h2', title } = Astro.props;
const t = useTranslations(locale);
---

{
  credits.length > 0 && (
    <section class="end-section">
      <Heading>{title ?? t('imageCredits')}</Heading>
      <ul class="credits">
        {credits.map(([, c]) => (
          <li>
            <a href={c.source} rel="noopener">
              {c.title.replace(/\.(jpe?g|png|webp)$/i, '')}
            </a>
            <span>{c.author}</span>
            <span>{c.licenseUrl ? <a href={c.licenseUrl} rel="license noopener">{c.license}</a> : c.license}</span>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .credits {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--step-16);
    line-height: 1.5;
  }
  .credits li {
    display: grid;
    gap: 0 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--rule-gold);
  }
  @media (min-width: 720px) {
    .credits li {
      grid-template-columns: 1fr 12rem 7.5rem;
    }
  }
  .credits a {
    overflow-wrap: anywhere;
  }
  .credits span {
    color: var(--ink-soft);
  }
</style>
